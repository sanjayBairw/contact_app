<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.details.ContactDetailsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_contact_details"
            app:navigationContentDescription="@string/action_navigate_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_contact_details"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Profile Hero Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_md">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size_detail"
                    android:layout_height="@dimen/avatar_size_detail">

                    <TextView
                        android:id="@+id/tvDetailInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                        android:textStyle="bold"
                        tools:text="AS" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Contactly.Circle" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Aarav Sharma" />

                <TextView
                    android:id="@+id/tvDetailRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    tools:text="Android Tech Lead • Pynexia Labs"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutDetailBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDetailFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:text="@string/badge_favorite"
                        android:visibility="gone"
                        app:chipCornerRadius="@dimen/chip_corner_radius"
                        app:chipIcon="@drawable/ic_star_filled"
                        app:chipIconTint="@color/contactly_favorite_active"
                        app:chipStrokeColor="@color/contactly_favorite_active"
                        app:chipStrokeWidth="1dp"
                        tools:visibility="visible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDetailSample"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:clickable="false"
                        android:text="@string/badge_sample"
                        android:visibility="gone"
                        app:chipCornerRadius="@dimen/chip_corner_radius"
                        app:chipStrokeColor="?attr/colorOutline"
                        app:chipStrokeWidth="1dp"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

            <!-- Quick Action Cards (Call, Message, Email) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActionCall"
                    style="@style/Widget.Contactly.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_call"
                    android:textColor="@color/contactly_call_tint"
                    android:textStyle="bold"
                    app:backgroundTint="@color/contactly_call_bg"
                    app:cornerRadius="@dimen/card_corner_radius"
                    app:icon="@drawable/ic_call"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/contactly_call_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActionMessage"
                    style="@style/Widget.Contactly.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_message"
                    android:textColor="@color/contactly_sms_tint"
                    android:textStyle="bold"
                    app:backgroundTint="@color/contactly_sms_bg"
                    app:cornerRadius="@dimen/card_corner_radius"
                    app:icon="@drawable/ic_message"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/contactly_sms_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActionEmail"
                    style="@style/Widget.Contactly.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_email"
                    android:textColor="@color/contactly_email_tint"
                    android:textStyle="bold"
                    app:backgroundTint="@color/contactly_email_bg"
                    app:cornerRadius="@dimen/card_corner_radius"
                    app:icon="@drawable/ic_email"
                    app:iconGravity="textTop"
                    app:iconPadding="4dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/contactly_email_tint" />

            </LinearLayout>

            <!-- Contact Information Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Contactly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_contact_info"
                        android:textAppearance="@style/TextAppearance.Contactly.SectionHeader" />

                    <!-- Phone row -->
                    <LinearLayout
                        android:id="@+id/rowPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_quick_call_pill">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_call"
                                app:tint="@color/contactly_call_tint" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_phone"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvDetailPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold"
                                tools:text="+91 98765 43210" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Email row -->
                    <LinearLayout
                        android:id="@+id/rowEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_stat_icon_primary">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_email"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_email"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvDetailEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="aarav.sharma@pynexia.dev" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Work Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWork"
                style="@style/Widget.Contactly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_work_info"
                        android:textAppearance="@style/TextAppearance.Contactly.SectionHeader" />

                    <!-- Company row -->
                    <LinearLayout
                        android:id="@+id/rowCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_stat_icon_primary">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_business"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_company"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvDetailCompany"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Pynexia Labs" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Job Title row -->
                    <LinearLayout
                        android:id="@+id/rowJobTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_stat_icon_primary">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_work"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_job_title"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvDetailJobTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Android Tech Lead" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Notes Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                style="@style/Widget.Contactly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_notes"
                        android:textAppearance="@style/TextAppearance.Contactly.SectionHeader" />

                    <TextView
                        android:id="@+id/tvDetailNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Mentoring Week 2 RecyclerView and Room persistence module." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Last updated timestamp -->
            <TextView
                android:id="@+id/tvUpdatedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Last updated Nov 12, 2026" />

            <!-- Edit & Delete Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditContact"
                    style="@style/Widget.Contactly.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/action_edit"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteContact"
                    style="@style/Widget.Contactly.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/action_delete"
                    android:textColor="?attr/colorError"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="?attr/colorError"
                    app:strokeColor="?attr/colorError" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
